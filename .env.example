# 复制为 .env 并填写真实值。.env 已被 gitignore, 不会提交。
# 火山方舟 API Key (必填): https://console.volcengine.com/ark
ARK_API_KEY=

# ---- 各能力默认模型 (均可按需修改) ----
# 视觉理解 (需先在控制台开通; 已验证 doubao-seed-2-0-pro-260215 可用)
VISION_MODEL=doubao-seed-2-0-pro-260215
# 备用视觉模型 (主模型失败/未开通时自动切换; 需先在控制台开通; 留空禁用备用)
VISION_MODEL_FALLBACK=doubao-seed-evolving
# 图像生成
IMAGE_MODEL=doubao-seedream-4-5-251128
# 图像编辑
EDIT_MODEL=doubao-seededit-3-0-i2i-250628
# 视频生成
VIDEO_MODEL=doubao-seedance-2-0-260128
# 3D 生成
MODEL3D=doubao-seed3d-2-0-260328
# 图文多模态向量化 (Embedding, 需先在控制台开通; 供语义检索/以图搜图使用)
EMBEDDING_MODEL=doubao-embedding-vision-251215
